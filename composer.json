{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.5",
        "dragonmantank/cron-expression": "^3.4",
        "enshrined/svg-sanitize": "^0.22.0",
        "erusev/parsedown": "*",
        "friendsofsymfony/jsrouting-bundle": "^3.5",
        "getbrevo/brevo-php": "^2.0",
        "giggsey/libphonenumber-for-php": "^9.0",
        "knplabs/knp-paginator-bundle": "^6.9",
        "knplabs/knp-time-bundle": "^2.4",
        "league/commonmark": "^2.7",
        "league/iso3166": "^4.3",
        "liip/imagine-bundle": "^2.15",
        "maestroerror/php-heic-to-jpg": "^1.0",
        "neitanod/forceutf8": "^2.0",
        "oro/doctrine-extensions": "^3.0",
        "phpoffice/phpspreadsheet": "^5.1",
        "spiriitlabs/form-filter-bundle": "^v12.0.1",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/requirements-checker": "^2.0",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-autocomplete": "^2.17",
        "symfony/ux-chartjs": "^2.36",
        "symfony/ux-icons": "^2.36",
        "symfony/ux-live-component": "*",
        "symfony/ux-turbo": "^2.17",
        "symfony/ux-twig-component": "^2.36",
        "symfony/validator": "8.1.*",
        "symfony/var-dumper": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/webpack-encore-bundle": "^2.1",
        "symfony/yaml": "8.1.*",
        "tinify/tinify": "^1.6",
        "twig/cache-extra": "^3.21",
        "twig/extra-bundle": "^3.21",
        "twig/intl-extra": "^3.21"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "requirements-checker": "script"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "nunomaduro/phpinsights": "^2.13",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.64",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    }
}
