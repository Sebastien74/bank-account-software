{% trans_default_domain 'exception' %}

{% set status_code = status_code is defined ? status_code : 'Erreur'|trans %}

<h2 class="h1 text-primary fw-700">{{ status_code|raw }}</h2>

{% if status_code == 404 %}
    <h2 class="mb-3 text-white">{{ "Oups! Page non trouvée."|trans|raw }}</h2>
    <p class="message text-white">{{ "Désolé, la page que vous recherchez n'existe pas, a été supprimée, son nom a été modifié ou est temporairement indisponible."|trans|raw }}</p>
{% elseif status_code == 401 %}
    <h2 class="mb-3 text-white">{{ "Oups! Accès refusé."|trans|raw }}</h2>
    <p class="message text-white">{{ "Vous n'avez pas accès à cette page."|trans|raw }}</p>
{% elseif status_code == 403 %}
    <h2 class="mb-3 text-white">{{ "Accès refusé !!!"|trans|raw }}</h2>
    <p class="text-danger fw-300 message">{{ exception.message }}</p>
{% else %}
    <h2 class="mb-3 text-white">{{ "Oups! Une erreur interne est survenue."|trans|raw }}</h2>
    <p class="text-white fw-300 message">{{ exception.message }}</p>
{% endif %}

{% if app.user or inAdmin %}
    <a href="{{ path('back_wallet_index') }}" class="btn btn-primary py-2 px-3 mt-3">{{ "Retourner aux comptes"|trans }}</a>
{% else %}
    <div class="d-flex">
        <a href="{{ path('security_login') }}" class="btn btn-primary py-2 px-3 text-uppercase mx-auto">{{ "Connectez-vous"|trans }}</a>
    </div>
{% endif %}
