{% trans_default_domain 'core' %}

<div id="strength-wrap" class="col-12 mb-3 d-none flex-column">
    <div class="progress bg-light" role="progressbar" aria-label="{{ 'Password check'|trans }}" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
        <div id="strength-bar" class="progress-bar" style="width: 0"></div>
    </div>
    <small id="strength-text" class="lh-1 mt-1 text-white"
           data-very-low="{{ 'Very weak'|trans|striptags }}"
           data-low="{{ 'Weak'|trans|striptags }}"
           data-medium="{{ 'Medium'|trans|striptags }}"
           data-strong="{{ 'Strong'|trans|striptags }}"
           data-very-strong="{{ 'Very strong'|trans|striptags }}"></small>
</div>
