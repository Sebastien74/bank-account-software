{% trans_default_domain 'core' %}

{% set icons = {
    success: {icon: 'check', bgColor: 'success', color: 'success', iconColor: 'white-50'},
    info: {icon: 'info', bgColor: 'info', color: 'primary', iconColor: 'white-50'},
    warning: {icon: 'exclamation', bgColor: 'warning', color: 'warning', iconColor: 'white-50'},
    danger: {icon: 'exclamation-triangle', bgColor: 'danger', color: 'danger', iconColor: 'white-50'},
    error: {icon: 'exclamation-triangle', bgColor: 'danger', color: 'danger', iconColor: 'white-50'},
    undefined: {icon: 'info', bgColor: 'primary', color: 'primary', iconColor: 'white'},
} %}

{# Le message d'un flash n'est pas du HTML : il vient parfois d'un fichier
   importé — `OperationManager` recopie une cellule brute du XLSX dans son
   rapport d'erreurs. Un `|raw` ici en faisait une XSS par relevé piégé. #}

{% set display = display is defined ? display : "toast" %}
{% set size = size is defined ? size : null %}
{% set icon = icons[alert].icon is defined ? icons[alert].icon : icons['undefined'].icon %}
{% set bgColor = icons[alert].bgColor is defined ? icons[alert].bgColor : icons['undefined'].bgColor %}
{% set color = icons[alert].color is defined ? icons[alert].color : icons['undefined'].color %}
{% set iconColor = icons[alert].iconColor is defined ? icons[alert].iconColor : icons['undefined'].iconColor %}
{% set help = help is defined ? help : null %}
{% set class = class is defined ? class : null %}

{% if 'alert' == display %}
    <div class="alert alert-{{ bgColor }} position-relative d-flex p-0 {% if class %} {{ class }}{% endif %}">
        <div class="icon d-flex align-items-center justify-content-center position-relative bg-{{ bgColor }}"><twig:ux:icon name="{{ ux_icon_name(icon) }}" class="text-{{ iconColor }}" /></div>
        <div class="message px-3 py-3 w-100 text-{{ iconColor }}">
            {% if 'small' == size %}
                <small class="d-inline-block text-{{ iconColor }}">
            {% endif %}
                {{ message }}
                {% if help %}
                    <br>{{ help }}
                {% endif %}
            {% if 'small' == size %}
                </small>
            {% endif %}
        </div>
    </div>
{% elseif 'ribbon' == display %}
    <div class="ribbon-vwrapper alert alert-{{ bgColor }}">
        <div class="ribbon ribbon-bookmark ribbon-vertical-l ribbon-{{ bgColor }}">
            <twig:ux:icon name="{{ ux_icon_name(icon) }}" class="text-{{ iconColor }}" />
        </div>
        <button class="btn-close" data-bs-dismiss="alert" aria-label="Close"> <span aria-hidden="true">×</span> </button>
        {% if message is defined %}
            {{ message }}
        {% else %}
            {{ 'What is happening?'|trans|raw }}
        {% endif %}
    </div>
{% elseif 'feedback' == display %}
    <div class="{% if 'error' == alert or 'danger' == alert %}invalid-feedback{% else %}feedback{% endif %} text-{{ bgColor }} d-flex">
        <twig:ux:icon name="{{ ux_icon_name(icon) }}" class="text-{{ bgColor }} position-relative me-2" />
        <span>{{ message }}</span>
    </div>
{% else %}
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div class="toast toast-alert fade show border-0 bg-{{ color }}" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header d-flex border-0 no-radius py-3 px-3 text-{{ bgColor }}">
                {# La couleur de sens est dans la seule icône : le toast reste
                   la surface, donc aucun couple de contraste n'est à remesurer
                   d'un sens à l'autre. #}
                <div class="inner d-flex align-items-center">
                    <span class="toast-icon toast-icon--{{ bgColor }} me-3"><twig:ux:icon name="{{ ux_icon_name(icon) }}" /></span>
                    <div class="message">{{ message }}</div>
                </div>
                <button type="button" class="btn-close ms-auto ps-3" data-bs-dismiss="toast" aria-label="{{ "Close"|trans|striptags }}"></button>
            </div>
        </div>
    </div>
{% endif %}
