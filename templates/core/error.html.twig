{% trans_default_domain 'core' %}

{% set inAdmin = app.user or (inAdmin is defined and inAdmin) %}

<section id="exception-block" class="{% if inAdmin %}my-5{% else %}text-center{% endif %}">
    <div id="errorStatus">
        <div class="errorStatus">
            <div class="errorStatus-code"></div>
            {% include 'bundles/TwigBundle/Exception/messages.html.twig' %}
        </div>
    </div>
</section>