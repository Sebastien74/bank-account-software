{% extends 'security/base.html.twig' %}

{% trans_default_domain 'security' %}

{% block title %}{{ 'Reset password'|trans|striptags }}{% endblock %}

{% block body %}
    {{ form_start(form, {attr: {
        id: "password-confirm-form",
        class: "form-horizontal security",
        novalidate: "novalidate"
    }}) }}
        <h2 class="text-white mb-4 h5 fw-600">{{ 'Reset password'|trans|raw }}</h2>
        {{ form_row(form.plainPassword) }}
        {{ form_errors(form) }}
        {% include "core/form/password-checker.html.twig" %}
        <small class="form-group col-12 form-text text-white mt-0 d-inline-block  mb-3">
            {{ "The password must contain a minimum of 8 characters, including at least one digit, one uppercase letter, and one lowercase letter."|trans|raw }}
        </small>
        <div class="col-xs-12">
            {{ form_row(form.submit) }}
            {% include 'core/flash-bag.html.twig' %}
            <div class="w-100 text-center">
                <a href="{{ path("security_login", {_locale: app.request.locale}) }}" class="text-white link d-inline-block mt-3" data-toggle="preloader">
                    <small>{{ 'Return to the login page'|trans|raw }}</small>
                </a>
            </div>
        </div>
        {{ form_rest(form) }}
    {{ form_end(form) }}
{% endblock %}
