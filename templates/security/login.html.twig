{% extends "security/base.html.twig" %}

{% trans_default_domain 'security' %}

{% block title %}{{ "Connexion"|trans|striptags }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block security_intro %}
    <p class="security-title">{{ "Connexion"|trans|striptags }}</p>
    <p class="security-subtitle">{{ "Accédez à la gestion de vos comptes"|trans|striptags }}</p>
{% endblock %}

{% block body %}
    {{ form_start(form, {attr: {
        novalidate: "novalidate",
        method: "POST",
        class: 'form-horizontal security',
        action: path('security_login'),
        id: "login-form",
    }}) }}
        {% for field in form.children %}
            {% if field.vars.name == '_remember_me' %}
                <div class="row mb-4">
                    <div id="remember-me-wrap" class="col-sm-6 d-flex justify-content-center justify-content-sm-start text-center text-sm-start">
            {% endif %}
                {{ form_row(form[field.vars.name]) }}
            {% if field.vars.name == '_remember_me' %}
                    </div>
                    <div class="col-sm-6 d-flex justify-content-center justify-content-sm-end text-center text-sm-end">
                        <a href="{{ path("security_password_request", {_locale: app.request.locale}) }}" id="to-recover" class="text-white" data-toggle="preloader">
                            <small class="text-italic lh-1 d-inline-block">{{ 'Forgot your password?'|trans|raw }}</small>
                        </a>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
        {% if error %}
            {% include 'core/alert.html.twig' with {alert: 'danger', display: 'alert', message: error.messageKey|trans(error.messageData, 'security')|raw} only %}
        {% endif %}
        {% include 'core/flash-bag.html.twig' %}
    {{ form_end(form) }}
{% endblock %}
