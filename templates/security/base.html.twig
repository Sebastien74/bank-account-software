{% trans_default_domain 'security' %}

<!DOCTYPE html>
<html lang="{{ app.request.locale }}">

    <head>

        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{% block title %}{{ "Bienvenue !!"|trans|striptags }}{% endblock %} - {{ companyName }}</title>
        <meta name="description" content="{{ companyName }}" />
        <meta name="author" content="{{ companyName }}" />

        <link rel="icon" type="image/png" href="{{ asset('favicon-96x96.png') }}" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}" />
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}" />
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}" />
        <meta name="apple-mobile-web-app-title" content="{{ companyName }}" />
        <link rel="manifest" href="{{ asset('site.webmanifest') }}" />

        {% block stylesheets %}
            {{ encore_entry_link_tags('security', null, 'security', {nonce: csp_nonce()}) }}
        {% endblock %}

    </head>

    <body class="base-theme">
        <section id="wrapper" class="login-register login-sidebar">
            <div id="bg-container" data-style="{{ asset('build/security/images/background-security.jpg', 'security') }}"></div>
            <aside class="login-box">
                <div class="inner position-relative h-100 d-flex">
                    {% include 'security/includes/preloader.html.twig' %}
                    <div class="row my-auto mx-auto m-0">
                        <header id="content" class="col-12 p-4">
                            <a href="{{ app.request.getSchemeAndHttpHost() }}" class="header w-100 d-inline-block text-center mb-5 mt-5 mt-md-0">
                                <span class="icon-wrap d-inline-flex align-items-center justify-content-center"><i class="icon-piggy-bank"></i></span>
                                <strong class="d-inline-block w-100 text-white text-uppercase mt-3">{{ companyName|striptags }}</strong>
                            </a>
                            {% block body %}{% endblock %}
                        </header>
                    </div>
                </div>
            </aside>
        </section>
        {% include 'core/data-path.html.twig' only %}
        {% block javascripts %}
            {{ encore_entry_script_tags('security', null, 'security', {nonce: csp_nonce()}) }}
        {% endblock %}
    </body>

</html>
