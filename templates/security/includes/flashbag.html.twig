{% trans_default_domain 'security' %}

{% for alertType, flashes in app.session.flashbag.all %}
    {% for flash in flashes %}
        {% set alertType = alertType == 'error' ? 'danger' : alertType %}
        {% set alertType = alertType == 'success' ? 'primary' : alertType %}
        {% include 'security/includes/alert.html.twig' with {alert: alertType, message: flash} only %}
    {% endfor %}
{% endfor %}