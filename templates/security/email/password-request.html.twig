{% extends 'core/email/base-felix.html.twig' %}

{% trans_default_domain 'security' %}

{% set resetLink = app.request.getSchemeAndHttpHost() ~ path('security_password_confirm', {_locale: app.request.locale, token: token|url_encode}) %}

{% block metaTitle %}{{ ('Réinitialisation du mot de passe')|trans|striptags }}{% endblock %}

{% block preheader %}
    {{ 'Cliquez sur le bouton ci-dessous pour réinitialiser votre mot de passe.'|trans }}
{% endblock %}

{% block headerRight %}
    {{ 'Sécurité du compte'|trans }}
{% endblock %}

{% block title %}
    {{ 'Réinitialisez votre mot de passe'|trans }}
{% endblock %}

{% block body %}

    <p style="margin:0 0 10px 0;">
        {{ 'Bonjour{name},'|trans({ '{name}': (userName is defined and userName ? ' ' ~ userName : '') }) }}
    </p>

    <p style="margin:0 0 14px 0;">
        {{ 'Vous avez demandé la réinitialisation de votre mot de passe. Cliquez sur le bouton ci-dessous pour poursuivre.'|trans }}
    </p>

    {# Button (bulletproof: VML for Outlook + normal fallback) #}
    <p style="margin:0 0 12px 0;">
        <!--[if mso]>
        <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="{{ resetLink }}"
                     style="height:44px;v-text-anchor:middle;width:320px;" arcsize="22%"
                     stroke="f" fillcolor="#7C6CFF">
            <w:anchorlock/>
            <center style="color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;">
                {{ 'Réinitialiser mon mot de passe'|trans }}
            </center>
        </v:roundrect>
        <![endif]-->

        <!--[if !mso]><!-- -->
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="btn" style="border-collapse:separate;">
        <tr>
            <td align="center" bgcolor="#7C6CFF" style="border-radius:12px;">
                <a href="{{ resetLink }}" target="_blank"
                   style="display:inline-block; padding:12px 18px; font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:800; color:#ffffff; text-decoration:none; border-radius:12px;">
                    {{ 'Réinitialiser mon mot de passe'|trans }}
                </a>
            </td>
        </tr>
    </table>
    <!--<![endif]-->
    </p>

    <p style="margin:0 0 10px 0;">
        {{ 'Ce lien est valable {hours} heures. Passé ce délai, vous devrez effectuer une nouvelle demande.'|trans({ '{hours}': 24 }) }}
    </p>

    <p style="margin:0 0 14px 0;">
        {{ "Si vous n'êtes pas à l'origine de cette demande, vous pouvez ignorer cet e-mail. Aucune modification ne sera effectuée sans action de votre part."|trans }}
    </p>

    <p style="margin:0; font-size:11.5px; line-height:1.6;">
        {{ 'Si le bouton ne fonctionne pas, copiez-collez ce lien dans votre navigateur :'|trans }}<br>
        <a href="{{ resetLink }}" target="_blank"
           style="color:#B179FF; text-decoration:underline; word-break:break-word;">
            {{ resetLink }}
        </a>
    </p>

{% endblock %}

{% block info %}
    {{ "Cet e-mail vous a été envoyé car nous avons reçu une demande de changement de mot de passe pour votre compte."|trans }}
{% endblock %}
