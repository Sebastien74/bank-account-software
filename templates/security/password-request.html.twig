{% extends "security/base.html.twig" %}

{% trans_default_domain 'security' %}

{% block title %}{{ 'Reset password'|trans|striptags }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {{ form_start(form, {attr: {
        id: "password-request-form",
        class: "form-horizontal security",
        novalidate: "novalidate"
    }}) }}
        <div class="col-12">
            <p class="text-white">{{ "Enter your email address to receive a password reset link."|trans|raw }}</p>
        </div>
        {{ form_row(form.email) }}
        {{ form_row(form.secure) }}
        <div class="text-center">
            {{ form_row(form.submit) }}
            <a href="{{ path("security_login", {_locale: app.request.locale}) }}" class="text-white link d-inline-block mt-3" data-toggle="preloader">
                <small>{{ 'Return to the login page'|trans|raw }}</small>
            </a>
        </div>
        <div class="col-12">
            {% include 'core/flash-bag.html.twig' %}
        </div>
    {{ form_end(form) }}
{% endblock %}
