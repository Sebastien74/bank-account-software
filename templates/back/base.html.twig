{% trans_default_domain 'back' %}

{% set pageIcon = pageIcon is defined and pageIcon ? pageIcon : 'wallet' %}
{% set pageTitle = pageTitle is defined and pageTitle ? pageTitle : "Mes comptes"|trans %}

<!doctype html>
<html lang="{{ app.request.locale }}" data-bs-theme="auto">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="" />
        <meta name="author" content="{{ companyName|striptags }}" />
        <title>{{ pageTitle|striptags ~' - '~companyName|striptags }}</title>
        <link rel="icon" type="image/png" href="{{ asset('favicon-96x96.png') }}" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}" />
        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}" />
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}" />
        <meta name="apple-mobile-web-app-title" content="{{ companyName|striptags }}" />
        <link rel="manifest" href="{{ asset('site.webmanifest') }}" />
        <link rel="canonical" href="{{ app.request.uri }}" />
        {{ encore_entry_link_tags('back-vendor', null, 'back', {nonce: csp_nonce()}) }}
        <meta name="theme-color" content="#712cf9" />
    </head>
    <body>
        {% include 'back/includes/flashbag.html.twig' %}
        {% include 'back/includes/header.html.twig' with {
            companyName: companyName,
            pageIcon: pageIcon,
            pageTitle: pageTitle,
        } only %}
        <div class="d-flex">
            {% include 'back/includes/sidebar.html.twig' %}
            <main id="main-container">
                {% include 'back/includes/breadcrumb.html.twig' with {
                    breadcrumb: breadcrumb is defined ? breadcrumb : []
                } only %}
                <div id="main-container-inner" class="px-5">
                    {% block body %}{% endblock %}
                </div>
            </main>
        </div>
        {{ encore_entry_script_tags('back-vendor', null, 'back', {defer: false, nonce: csp_nonce()}) }}
        <div id="data-translation" class="d-none"
             data-search="{{ "Chercher"|trans|striptags }}"
        ></div>
    </body>
</html>