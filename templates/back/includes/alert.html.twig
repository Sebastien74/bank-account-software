{% trans_default_domain 'back' %}

{% set icons = {
    success: {icon: 'check', bgColor: 'success', color: 'success', toastColor: 'white', iconColor: 'white', toastIconColor: 'white'},
    info: {icon: 'info', bgColor: 'primary', color: 'primary', toastColor: 'primary', iconColor: 'white', toastIconColor: 'primary'},
    warning: {icon: 'exclamation', bgColor: 'warning', color: 'warning', toastColor: 'dark', iconColor: 'inherit', toastIconColor: 'dark'},
    danger: {icon: 'exclamation-triangle', bgColor: 'danger', color: 'danger', toastColor: 'white', iconColor: 'white', toastIconColor: 'white'},
    error: {icon: 'exclamation-triangle', bgColor: 'danger', color: 'danger', toastColor: 'white', iconColor: 'white', toastIconColor: 'white'},
    undefined: {icon: 'info', bgColor: 'primary', color: 'primary', toastColor: 'primary', iconColor: 'white', toastIconColor: 'primary'},
} %}

{% set display = display is defined ? display : "toast" %}
{% set size = size is defined ? size : null %}
{% set icon = icons[alert].icon is defined ? icons[alert].icon : icons['undefined'].icon %}
{% set bgColor = icons[alert].bgColor is defined ? icons[alert].bgColor : icons['undefined'].bgColor %}
{% set color = icons[alert].color is defined ? icons[alert].color : icons['undefined'].color %}
{% set iconColor = icons[alert].iconColor is defined ? icons[alert].iconColor : icons['undefined'].iconColor %}
{% set toastColor = icons[alert].toastColor is defined ? icons[alert].toastColor : icons['undefined'].toastColor %}
{% set toastIconColor = icons[alert].toastIconColor is defined ? icons[alert].toastIconColor : icons['undefined'].toastIconColor %}
{% set class = class is defined ? class : null %}

{% if 'alert' == display %}
    <div class="alert alert-{{ bgColor }} position-relative d-flex p-0 {% if class %} {{ class }}{% endif %}">
        <div class="icon d-flex align-items-center justify-content-center position-relative bg-{{ bgColor }}"><i class="icon-{{ icon }} text-{{ iconColor }}"></i></div>
        <div class="message px-4 py-3 w-100">{% if 'small' == size %}<small class="d-inline-block">{% endif %}{{ message|raw }}{% if 'small' == size %}</small>{% endif %}</div>
    </div>
{% else %}
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div class="toast toast-alert fade show border-0 bg-{{ color }}" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header d-flex border-0 no-radius py-3 px-3 text-{{ toastColor }}">
                <div class="inner d-flex align-items-center">
                    <i class="icon-{{ icon }} text-{{ toastIconColor }} me-2"></i>
                    <div class="message">{{ message|raw }}</div>
                </div>
                <button type="button" class="btn-close ms-3" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
{% endif %}