{% trans_default_domain 'back' %}

<header class="navbar w-100 p-0">
    <a href="{{ path('back_wallet_index') }}" class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 text-white d-flex align-items-center h-100">
        <span class="icon-wrap d-flex align-items-center justify-content-center me-3">
            <twig:ux:icon name="tabler:building-bank" />
        </span>
        <div>
            <span class="fw-600">{{ companyName|striptags }}</span><br>
        </div>
    </a>
    <div class="right d-flex align-items-center h-100 pe-4">
        <button class="navbar-toggler nav-toggler-icon-wrap d-flex d-lg-none flex-column me-3" aria-label="{{ "Menu"|trans|raw }}">
            <span class="nav-toggler-icon" aria-label="{{ "Menu"|trans|raw }}">
                <span></span>
                <span></span>
                <span></span>
            </span>
        </button>
        <div class="title-wrap d-none d-lg-inline-flex align-items-center pe-4">
            {% if pageIcon %}
                <span class="icon-wrap d-flex align-items-center justify-content-center me-2">
                    <twig:ux:icon name="{{ ux_icon_name(pageIcon) }}" />
                </span>
            {% endif %}
            {# Le titre de la page est porte par le <h1> du corps. Un <h2> ici, rendu
   avant <main>, ouvrait la hierarchie de chaque ecran sur un niveau 2
   qui redisait le meme texte. #}
            <p class="title fw-400 text-white mb-0">{{ pageTitle|striptags }}</p>
        </div>
        {% if granted('ROLE_DEV') %}
            <span id="open-btn-opposite" class="icon-wrap cursor d-flex align-items-center justify-content-center ms-auto"><twig:ux:icon name="tabler:settings" class="text-white" /></span>
        {% endif %}
    </div>
</header>
