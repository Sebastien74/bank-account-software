{% trans_default_domain 'back' %}

{# Pied de liste de la référence : le compte à gauche, la pagination à droite,
   tous deux dans la carte du tableau. #}
{% if pagination.getTotalItemCount is defined and (pagination.getTotalItemCount / pagination.itemNumberPerPage) > 0 %}
    {% set class = class is defined and class ? class : false %}
    <div class="pagination-nav d-flex flex-wrap align-items-center gap-3{% if class %} {{ class }}{% endif %}">
        {% set delta = (pagination.itemNumberPerPage - pagination|length) %}
        {% set itemsCountStart = pagination.currentPageNumber == 1 ? 1 : (pagination.itemNumberPerPage * pagination.currentPageNumber) - pagination.itemNumberPerPage + 1 %}
        {% set itemsCountEnd = (pagination.itemNumberPerPage * pagination.currentPageNumber) - delta %}
        {# Le compte est composé en Twig, pas par le traducteur : le projet n'a
           pas de catalogue de fichiers, et une clé non trouvée ressortirait
           avec ses marqueurs en clair — ce qu'elle faisait. #}
        <span class="pagination-counter">
            {{ "Affichage de"|trans|striptags }}
            {{ itemsCountStart }} {{ "à"|trans|striptags }} {{ itemsCountEnd }}
            {{ "sur"|trans|striptags }} {{ pagination.getTotalItemCount() }}
        </span>
        <div class="ms-auto">{{ knp_pagination_render(pagination) }}</div>
    </div>
{% endif %}
