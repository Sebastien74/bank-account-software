{% trans_default_domain 'back' %}

{# Le fil d'Ariane de la référence est une ligne de texte : des maillons en
   violet, une barre oblique grise, et le dernier maillon en clair. Il nomme le
   chemin, il n'a pas à peser autant que le contenu. #}
{% if breadcrumb is not empty %}
    <nav class="breadcrumb-container" aria-label="{{ "Fil d'Ariane"|trans|striptags }}">
        <ol class="page-breadcrumb breadcrumb">
            {% for item, path in breadcrumb %}
                <li class="breadcrumb-item{% if loop.last %} active{% endif %}"{% if loop.last %} aria-current="page"{% endif %}>
                    {%- if loop.last -%}
                        {{ item }}
                    {%- else -%}
                        <a href="{{ path }}">{{ item }}</a>
                    {%- endif -%}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
