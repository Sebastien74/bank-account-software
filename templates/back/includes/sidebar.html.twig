{% trans_default_domain 'back' %}

<div id="sidebar-menu" class="sidebar bg-dark py-4">
    <div tabindex="-1">
        <ul class="nav flex-column mt-4">
            {% set active = 'dashboard' in app.request.uri %}
            <li class="nav-item d-flex">
                <a href="{{ path('back_dashboard') }}" class="nav-link d-inline-flex align-items-center text-white mb-3 mx-auto py-2 px-4{% if active %} active{% endif %}">
                    <span class="d-inline-flex align-items-center justify-content-center me-3 my-1">
                        <i class="icon-tachometer-alt"></i>
                    </span>
                    {{ "Tableau de bord"|trans|raw }}
                </a>
            </li>
            <li class="nav-item d-flex">
                {% set active = 'wallet' in app.request.uri %}
                <a href="{{ path('back_wallet_index') }}" class="nav-link d-inline-flex align-items-center text-white mb-3 mx-auto py-2 px-4{% if active %} active{% endif %}">
                    <span class="d-inline-flex align-items-center justify-content-center me-3 my-1">
                        <i class="icon-wallet"></i>
                    </span>
                    {{ "Gérer mes comptes"|trans|raw }}
                </a>
            </li>
            <li class="nav-item d-flex">
                {% set active = 'statistics' in app.request.uri %}
                <a href="{{ path('back_statistics') }}" class="nav-link d-inline-flex align-items-center text-white mb-3 mx-auto py-2 px-4{% if active %} active{% endif %}">
