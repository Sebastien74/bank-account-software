{% trans_default_domain 'back' %}

{% set route = 'back_'~interface.name~'_edit' %}
{% set routeArgs = route|routeArgs(entity) %}

{# Même registre que la corbeille : pictogramme neutre, couleur au survol. #}
<a href="{{ path(route, routeArgs) }}" class="row-action row-action--primary edit-btn"
   data-bs-toggle="tooltip" data-bs-title="{{ "Éditer"|trans|striptags }}"
   aria-label="{{ "Éditer"|trans|striptags }}">
    <twig:ux:icon name="tabler:pencil" />
</a>
