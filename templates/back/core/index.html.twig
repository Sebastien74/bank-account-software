{% extends "back/base.html.twig" %}

{% trans_default_domain 'back' %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <div id="entities-index-page" class="container-fluid pt-4 pb-5 position-relative">
        {% include 'back/core/new-modal.html.twig' with {
            excludedFields: excludedFields,
            addBtnLabel: addBtnLabel is defined and addBtnLabel ? addBtnLabel : 'Ajouter'|trans,
            form: form is defined and form ? form : false,
            formErrors: formErrors is defined and formErrors ? formErrors : false,
        } only %}
        {% if pagination is defined %}
            <div id="entities-index" class="mt-4">
                <table class="table table-striped table-dark">
                    <tbody>
                        {% for entity in pagination %}
                            <tr>
                                {% if referClass.icon is defined %}
                                    {% set icon = entity.icon ? entity.icon : 'far exclamation' %}
                                    <td class="align-middle text-center media-col">{{ icon|icon(null, 25, 'white') }}</td>
                                {% endif %}
                                <td class="px-4 align-middle">
                                    {{ entity.adminName|raw }}
                                </td>
                                {% if buttons is not empty %}
                                    {% for buttonsProperty, route in interface.buttons %}
                                        {% set label = labels[route] is defined ? labels[route] : route %}
                                        {% set routeArgs = route|routeArgs(entity) %}
                                        <td>
                                            <a href="{{ path(route, routeArgs) }}" class="">
                                                {% set counter = entity|countCollection(buttonsProperty) %}
                                                {{ label }}{% if counter %}<span class="badge badge-info-darken ms-2">{{ counter }}</span>{% endif %}
                                            </a>
                                        </td>
                                    {% endfor %}
                                {% endif %}
                                <td class="text-end px-4">
                                    {% include 'back/core/edit-btn.html.twig' with {interface: interface, entity: entity} only %}
                                    {% include 'back/core/delete-modal.html.twig' with {interface: interface, entity: entity} only %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% include 'back/includes/pagination.html.twig' with {pagination: pagination} only %}
            </div>
        {% endif %}
    </div>
{% endblock %}
