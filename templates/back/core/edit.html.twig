{% extends "back/base.html.twig" %}

{% trans_default_domain 'back' %}

{% block body %}
    {# Formulaire de contenu de la référence (form-layouts-vertical) : une
       carte, le libellé au-dessus du champ, et les actions graduées en pied. #}
    <div id="entity-edit" class="container-fluid pt-2 pb-5 position-relative">
        {{ form_start(form, {attr: {
            novalidate: "novalidate",
        }}) }}
            <div class="card">
                <div class="card-header">
                    <div>
                        <h1 class="card-title">{{ pageTitle|striptags }}</h1>
                        <p class="card-subtitle">{{ "Les champs marqués d'un astérisque sont obligatoires."|trans|raw }}</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        {% for field in form.children %}
                            {% set notExcluded = field.vars.name not in excludedFields %}
                            {% if notExcluded %}
                                {{ form_row(form[field.vars.name]) }}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
                <div class="card-footer d-flex flex-wrap align-items-center gap-2">
                    {# Le referer est posé par le navigateur : une page externe liant vers
                       cet écran transformerait « Annuler » en lien sortant. On ne le suit
                       que s'il est de même origine. #}
                    {% set referer = app.request.headers.get('referer') %}
                    {% set backUrl = referer and referer starts with app.request.schemeAndHttpHost
                        ? referer : path('back_wallet_index') %}
                    <a href="{{ backUrl }}" class="btn btn-label-secondary">{{ "Annuler"|trans|raw }}</a>
                    <span class="ms-auto d-inline-flex flex-wrap gap-2">
                        {% if form.saveBack is defined %}
                            {{ form_row(form.saveBack) }}
                        {% endif %}
                        {% if form.save is defined %}
                            {{ form_row(form.save) }}
                        {% endif %}
                    </span>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
