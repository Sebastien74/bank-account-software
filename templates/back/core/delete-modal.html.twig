{% trans_default_domain 'back' %}

{# L'action d'une ligne de tableau est un pictogramme neutre qui prend sa
   couleur de sens au survol : trois corbeilles rouges par ligne feraient d'un
   index une alerte (app-user-list). #}
<span data-bs-toggle="tooltip" data-bs-title="{{ "Supprimer"|trans|striptags }}">
    <button type="button" class="row-action row-action--danger delete-btn"
            data-bs-toggle="modal" data-bs-target="#delete-modal-{{ entity.id }}"
            aria-label="{{ "Supprimer"|trans|striptags }}">
        <twig:ux:icon name="tabler:trash" />
    </button>
</span>

<div class="modal fade" id="delete-modal-{{ entity.id }}" tabindex="-1" aria-hidden="true"
     aria-labelledby="delete-modal-{{ entity.id }}-title" aria-describedby="delete-modal-{{ entity.id }}-desc">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="delete-modal-{{ entity.id }}-title">{{ "Supprimer"|trans|raw }}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ "Fermer"|trans|raw }}"></button>
            </div>
            <div class="modal-body text-center">
                <twig:ux:icon name="tabler:alert-triangle" class="large text-warning" />
                <p class="delete-alert mb-0 mt-3" id="delete-modal-{{ entity.id }}-desc">{{ "Êtes-vous sûr ?"|trans|raw }}</p>
                <p class="text-secondary small mb-0 mt-1">{{ "Cette suppression est définitive."|trans|raw }}</p>
            </div>
            {# La confirmation est l'action destructrice : elle porte le rouge,
               et l'annulation reste le choix par défaut, à gauche.

               Elle passe par un formulaire POST avec son jeton, pas par un
               lien : une suppression en GET s'exécute sur simple navigation,
               et SameSite=lax laisse passer le cookie de session dans ce
               cas-là. Le jeton est revalidé dans `GlobalManager::delete()`. #}
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary me-auto" data-bs-dismiss="modal">{{ "Annuler"|trans|raw }}</button>
                {% set route = 'back_'~interface.name~'_delete' %}
                {% set routeArgs = route|routeArgs(entity) %}
                <form method="post" action="{{ path(route, routeArgs) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ interface.name ~ '-' ~ entity.id) }}">
                    <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-2">
                        <twig:ux:icon name="tabler:trash" width="17" height="17" />
                        <span>{{ "Confirmer"|trans|raw }}</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
