<div class="accordion accordion-flush" id="accordion-{{ idPrefix }}">
    {% for catId, category in stats %}
        <div class="accordion-item bg-transparent border-bottom border-secondary">
            <h2 class="accordion-header" id="heading-{{ idPrefix }}-{{ catId }}">
                <button class="accordion-button collapsed bg-transparent text-white shadow-none d-flex justify-content-between align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ idPrefix }}-{{ catId }}" aria-expanded="false" aria-controls="collapse-{{ idPrefix }}-{{ catId }}">
                    <span class="flex-grow-1">
                        {{ category.name }}
                        {% if category.trend is defined and category.trend is not null %}
                            <span class="ms-2 badge bg-{{ category.trend.color }} d-inline-flex align-items-center" data-bs-toggle="tooltip" data-bs-title="{{ "Tendance par rapport au %day% du même mois l'année précédente"|trans({'%day%': comparisonDay}) }}">
                                <i class="icon-arrow-{{ category.trend.direction == 'stable' ? 'right' : category.trend.direction }} me-1"></i>
                                {{ category.trend.percentage|number_format(0) }}%
                            </span>
                        {% endif %}
                    </span>
                    <span class="badge bg-primary me-3">{{ category.total|number_format(2, ',', ' ') }} €</span>
                </button>
            </h2>
            <div id="collapse-{{ idPrefix }}-{{ catId }}" class="accordion-collapse collapse" aria-labelledby="heading-{{ idPrefix }}-{{ catId }}" data-bs-parent="#accordion-{{ idPrefix }}">
                <div class="accordion-body py-2">
                    <ul class="list-group list-group-flush">
                        {% for subCategory in category.subCategories %}
                            <li class="list-group-item bg-transparent text-white border-0 d-flex justify-content-between align-items-center py-1">
                                <div class="d-flex align-items-center">
                                    <small class="me-2">{{ subCategory.name }}</small>
                                    {% if subCategory.trend is defined and subCategory.trend is not null %}
                                        <small class="text-{{ subCategory.trend.color }} d-inline-flex align-items-center" style="font-size: 0.75rem;" data-bs-toggle="tooltip" data-bs-title="{{ "Tendance par rapport au %day% du même mois l'année précédente"|trans({'%day%': comparisonDay}) }}">
                                            <i class="icon-arrow-{{ subCategory.trend.direction == 'stable' ? 'right' : subCategory.trend.direction }} me-1"></i>
                                            {{ subCategory.trend.percentage|number_format(0) }}%
                                        </small>
                                    {% endif %}
                                </div>
                                <small class="text-muted">{{ subCategory.total|number_format(2, ',', ' ') }} €</small>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
