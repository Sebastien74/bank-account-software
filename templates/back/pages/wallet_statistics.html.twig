{% extends "back/base.html.twig" %}

{% trans_default_domain 'back' %}

{% block body %}
    <div id="wallet-statistics" class="container-fluid pt-4 pb-5">
        <div class="row">
            <div class="col-12">
                <div class="card bg-dark text-white mb-4">
                    <div class="card-header py-3 d-flex align-items-center justify-content-between flex-wrap">
                        <h3 class="title h5 mb-0">{{ wallet.adminName|raw }} - {{ "Statistiques"|trans }}</h3>

                        <form method="get" class="d-flex align-items-center mt-3 mt-md-0">
                            <select name="month" class="form-select initial form-select-sm bg-dark text-white border-secondary me-2">
                                {% for value, label in months %}
                                    <option value="{{ value }}" {{ value == selectedMonth ? 'selected' : '' }}>{{ label|trans }}</option>
                                {% endfor %}
                            </select>
                            <select name="year" class="form-select initial form-select-sm bg-dark text-white border-secondary me-2">
                                {% for year in years %}
                                    <option value="{{ year }}" {{ year == selectedYear ? 'selected' : '' }}>{{ year }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm me-3">
                                <i class="icon-refresh"></i>
                            </button>
                            <a href="{{ path('back_wallet_index') }}" class="btn btn-primary btn-sm">
                                <i class="icon-arrow-left me-1"></i> {{ "Retour"|trans }}
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6">
                <div class="card bg-dark text-white mb-4">
                    <div class="card-header py-3">
                        <h4 class="h6 mb-0">{{ months[selectedMonth]|trans }} {{ selectedYear }}</h4>
                    </div>
                    <div class="card-body">
                        {% if monthStats is empty %}
                            <p class="text-muted mb-0">{{ "Aucune donnée disponible pour ce mois."|trans }}</p>
                        {% else %}
                            <div class="alert alert-info py-2 px-3 mb-3" style="font-size: 0.85rem;">
                                <i class="icon-info-sign me-1"></i>
                                {{ "Les tendances sont calculées du 1er au %day% %month% par rapport à la même période l'année précédente."|trans({'%day%': comparisonDay == 1 ? '1er' : comparisonDay, '%month%': months[selectedMonth]|trans}) }}
                                {% if comparisonDay < (endMonth|date('d')) %}
                                    <br>
                                    <strong class="text-warning">
                                        <i class="icon-warning-sign me-1"></i>
                                        {{ "Les jours du %start% au %end% sont exclus car sans données l'année précédente."|trans({
                                            '%start%': (comparisonDay + 1),
                                            '%end%': endMonth|date('d')
                                        }) }}
                                    </strong>
                                {% endif %}
                            </div>
                            {% include 'back/pages/includes/_stats_accordion.html.twig' with {
                                stats: monthStats,
                                idPrefix: 'month',
                                tooltipTitle: "Tendance par rapport au %day% %month% de l'année précédente"|trans({'%day%': comparisonDay, '%month%': months[selectedMonth]|trans})
                            } %}
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card bg-dark text-white mb-4">
                    <div class="card-header py-3">
                        <h4 class="h6 mb-0">{{ "Année"|trans }} {{ selectedYear }}</h4>
                    </div>
                    <div class="card-body">
                        {% if yearStats is empty %}
                            <p class="text-muted mb-0">{{ "Aucune donnée disponible pour cette année."|trans }}</p>
                        {% else %}
                            <div class="alert alert-info py-2 px-3 mb-3" style="font-size: 0.85rem;">
                                <i class="icon-info-sign me-1"></i>
                                {{ "Les tendances sont calculées du %startDay% %startMonth% au %day% %month% par rapport à la même période l'année précédente."|trans({
                                    '%startDay%': comparisonYearStartDay == 1 ? '1er' : comparisonYearStartDay,
                                    '%startMonth%': months[comparisonYearStartMonth|format('%02d')]|default('Janvier')|trans,
                                    '%day%': comparisonYearDay == 1 ? '1er' : comparisonYearDay,
                                    '%month%': months[comparisonYearMonth|format('%02d')]|default('')|trans
                                }) }}
                                {% if excludedMonths is not empty %}
                                    <br>
                                    <strong class="text-warning">
                                        <i class="icon-warning-sign me-1"></i>
                                        {% set excludedNames = [] %}
                                        {% for m in excludedMonths %}
                                            {% set excludedNames = excludedNames|merge([months[m]|trans]) %}
                                        {% endfor %}
                                        {{ "Mois exclus des calculs car sans données l'année précédente :"|trans }} {{ excludedNames|join(', ') }}
                                    </strong>
                                {% endif %}
                            </div>
                            {% include 'back/pages/includes/_stats_accordion.html.twig' with {
                                stats: yearStats,
                                idPrefix: 'year',
                                tooltipTitle: "Tendance par rapport au %day% %month% de l'année précédente"|trans({'%day%': comparisonYearDay, '%month%': months[comparisonYearMonth|format('%02d')]|default('')|trans})
                            } %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
