{% extends "back/base.html.twig" %}

{% trans_default_domain 'back' %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <div id="wallets-dashboard" class="container-fluid pt-4 pb-5 position-relative">
        {% include 'back/core/new-modal.html.twig' with {
            excludedFields: excludedFields,
            addBtnLabel: addBtnLabel is defined and addBtnLabel ? addBtnLabel : 'Ajouter'|trans,
            form: form is defined and form ? form : false,
            formErrors: formErrors is defined and formErrors ? formErrors : false,
        } only %}
        <div id="wallets-index" class="row mt-4">
            {% for wallet in pagination %}
                <div class="col-lg-4">
                    <div class="card bg-dark">
                        <div class="card-header py-3">
                            <h3 class="title h5 text-white mb-0">{{ wallet.adminName|raw }}</h3>
                        </div>
                        <div class="card-body text-white">
                            <div class="mb-2"><strong>Solde :</strong> {{ wallet.balance|number_format(2, ',', ' ') }} €</div>
                            <div class="mb-2"><strong>Moyennes dépenses quotidiennes :</strong> {{ wallet.dailyAverageExpenses|number_format(2, ',', ' ') }} €</div>
                            <div><strong>Reste à dépenser / jour :</strong> {{ wallet.remainingDailyBudget|number_format(2, ',', ' ') }} €</div>
                        </div>
                        <div class="card-footer d-flex align-items-center py-3">
                            <a href="{{ path('back_wallet_edit', {wallet: wallet.id}) }}" class="btn btn-primary btn-circle d-flex align-items-center justify-content-center me-2"
                               data-bs-toggle="tooltip" data-bs-title="{{ "Configuration"|trans|striptags }}">
                                <i class="icon-cog"></i>
                            </a>
                            <a href="{{ path('back_operation_index', {wallet: wallet.id}) }}" class="btn btn-primary btn-circle d-flex align-items-center justify-content-center me-3"
                               data-bs-toggle="tooltip" data-bs-title="{{ "Mes opérations"|trans|striptags }}">
                                <i class="icon-list-alt"></i>
                            </a>
                            <a href="{{ path('back_operation_statistics', {wallet: wallet.id}) }}" class="btn btn-primary btn-circle d-flex align-items-center justify-content-center me-3"
                               data-bs-toggle="tooltip" data-bs-title="{{ "Statistiques"|trans|striptags }}">ssssssss
                                <i class="icon-bar-chart"></i>
                            </a>
                            <span class="ms-auto">{% include 'back/core/delete-modal.html.twig' with {entity: wallet} %}</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% include 'back/includes/pagination.html.twig' with {pagination: pagination, class: 'mt-4'} only %}
    </div>
{% endblock %}
